<section class="video">
  <h3 class="visually-hidden">Видео</h3>

  <div class="video__box">
    <p class="video__question">Все еще сомневаетесь?</p>
    <p class="video__intro">
      Смотрите видеопрезентацию и скорее за билетами, пока они не подорожали в
      очередной раз!
    </p>
  </div>

  <div class="video__wrapper" data-player>
    <video
      class="video__media"
      src="/sedona.mp4"
      poster="/img/video-desktop@1x.jpg"
      preload="metadata"
      autoplay
      muted
      loop
      playsinline
      data-player-media></video>

    <div class="video__container">
      <div class="video__wrapper-controls">
        <button
          class="video__button video__button--toggle"
          type="button"
          data-player-toggle
        >
          <span class="visually-hidden" data-player-toggle-label
            >Включить видео</span
          >
          <svg
            class="video__icon video__icon--play"
            width="20"
            height="20"
            aria-hidden="true"
          >
            <use href="#icon-video-play"></use>
          </svg>
          <svg
            class="video__icon video__icon--pause"
            width="20"
            height="20"
            aria-hidden="true"
          >
            <use href="#icon-video-pause"></use>
          </svg>
        </button>

        <button class="video__button" type="button" data-player-replay>
          <span class="visually-hidden">Проиграть заново</span>
          <svg
            class="video__icon video__icon--replay"
            width="16"
            height="20"
            aria-hidden="true"
          >
            <use href="#icon-video-replay"></use>
          </svg>
        </button>

        <div class="video__control">
          <div class="video__scale" aria-hidden="true">
            <span class="video__played"></span>
          </div>
          <input
            class="video__progress"
            type="range"
            min="0"
            max="1000"
            step="1"
            value="0"
            aria-label="Перемотка видео"
            data-player-progress
          />
        </div>

        <button
          class="video__button video__button--sound"
          type="button"
          data-player-sound
        >
          <span class="visually-hidden" data-player-sound-label
            >Выключить звук</span
          >
          <svg
            class="video__icon video__icon--sound"
            width="20"
            height="20"
            aria-hidden="true"
          >
            <use href="#icon-video-sound"></use>
          </svg>
          <svg
            class="video__icon video__icon--muted"
            width="20"
            height="20"
            aria-hidden="true"
          >
            <use href="#icon-video-muted"></use>
          </svg>
        </button>

        <button
          class="video__button video__button--fullscreen"
          type="button"
          data-player-fullscreen
        >
          <span class="visually-hidden">На весь экран</span>
          <svg
            class="video__icon video__icon--fullscreen"
            width="20"
            height="20"
            aria-hidden="true"
          >
            <use href="#icon-video-fullscreen"></use>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import { initVideo } from '@/scripts/video'

  initVideo()
</script>

