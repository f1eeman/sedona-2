---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { localeOf, useTranslations } from '@/i18n'
import { NAV_HREF, NAV_KEYS, type NavKey } from '@/data/nav'

interface Props {
  page: NavKey
}

const { page } = Astro.props

const locale = localeOf(Astro.currentLocale)
const t = useTranslations(Astro.currentLocale)
const homeHref = getRelativeLocaleUrl(locale, NAV_HREF.index)
---

<header class="page-header">
  <nav class="page-header__main-nav main-nav">
    <details class="main-nav__menu" data-menu>
      <summary
        class="main-nav__toggle"
        data-menu-toggle
        data-menu-label-open={t.menu.open}
        data-menu-label-close={t.menu.close}
      >
        <span class="visually-hidden" data-menu-label>{t.menu.open}</span>
        <span class="main-nav__burger" aria-hidden="true">
          <span class="main-nav__line"></span>
          <span class="main-nav__line"></span>
          <span class="main-nav__line"></span>
        </span>
      </summary>
      <ul class="main-nav__site-list site-list">
        {
          NAV_KEYS.map((key) => (
            <li
              class:list={[
                'site-list__item',
                key === page && 'site-list__item--active',
              ]}
            >
              {key === page ? (
                <span class="site-list__link">{t.nav[key]}</span>
              ) : (
                <a
                  class="site-list__link"
                  href={getRelativeLocaleUrl(locale, NAV_HREF[key])}
                >
                  {t.nav[key]}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </details>

    {
      page === 'index' ? (
        <span class="main-nav__logo">
          <picture>
            <source
              media="(min-width: 1200px)"
              srcset="/img/logo-sedona-desktop.svg"
            />
            <source
              media="(min-width: 768px)"
              srcset="/img/logo-sedona-tablet.svg"
            />
            <img
              class="main-nav__logo-image"
              src="/img/logo-sedona-mobile.svg"
              width="102"
              height="83"
              alt="Sedona"
            />
          </picture>
        </span>
      ) : (
        <a class="main-nav__logo" href={homeHref}>
          <picture>
            <source
              media="(min-width: 1200px)"
              srcset="/img/logo-sedona-desktop.svg"
            />
            <source
              media="(min-width: 768px)"
              srcset="/img/logo-sedona-tablet.svg"
            />
            <img
              class="main-nav__logo-image"
              src="/img/logo-sedona-mobile.svg"
              width="102"
              height="83"
              alt="Sedona"
            />
          </picture>
        </a>
      )
    }
  </nav>
</header>

<script>
  import { initMenu } from '@/scripts/menu'

  initMenu()
</script>

<style>
  .page-header__main-nav {
    margin-inline: auto;
  }

  .main-nav {
    position: relative;
    z-index: 1;
    min-height: 55px;
    color: var(--color-text);
  }

  .main-nav__logo {
    position: absolute;
    top: 0;
    left: 50%;
    display: block;
    width: 102px;
    height: 83px;
    margin-left: -51px;
    transition: opacity var(--duration-quick) var(--ease-out);
    view-transition-name: sedona-logo;
  }

  a.main-nav__logo:focus-visible {
    outline: 3px solid var(--color-text-strong);
    outline-offset: 3px;
  }

  .main-nav__logo::before {
    content: '';
    position: absolute;
    inset: 0;
    display: block;
  }

  a.main-nav__logo:hover,
  a.main-nav__logo:focus {
    opacity: 0.6;
  }

  a.main-nav__logo:active {
    opacity: 0.3;
  }

  .main-nav__logo-image {
    width: 102px;
    height: 83px;
  }

  .main-nav__toggle {
    position: absolute;
    top: 7px;
    right: 12px;
    z-index: 10;
    display: block;
    width: 40px;
    height: 40px;
    list-style: none;
    cursor: pointer;
  }

  .main-nav__toggle::-webkit-details-marker {
    display: none;
  }

  .main-nav__burger {
    position: absolute;
    top: 10px;
    left: 9px;
    display: block;
    width: 23px;
    height: 20px;
  }

  .main-nav__line {
    position: absolute;
    left: 0;
    width: 23px;
    height: 4px;
    background-color: var(--color-brand);
    transition:
      translate var(--duration-base) var(--ease-out),
      rotate var(--duration-base) var(--ease-out),
      scale var(--duration-base) var(--ease-out),
      opacity var(--duration-quick) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .main-nav__line:nth-child(1) {
    top: 0;
  }

  .main-nav__line:nth-child(2) {
    top: 8px;
  }

  .main-nav__line:nth-child(3) {
    top: 16px;
  }

  .main-nav__menu[open] .main-nav__line {
    background-color: var(--color-bg);
  }

  .main-nav__menu[open] .main-nav__line:nth-child(1) {
    translate: 0 8px;
    rotate: 45deg;
    scale: 1.26 1;
  }

  .main-nav__menu[open] .main-nav__line:nth-child(2) {
    opacity: 0;
    scale: 0.2 1;
  }

  .main-nav__menu[open] .main-nav__line:nth-child(3) {
    translate: 0 -8px;
    rotate: -45deg;
    scale: 1.26 1;
  }

  @media (width < 768px) {
    .main-nav:has(.main-nav__menu[open]) {
      padding-bottom: 55px;
    }

    .main-nav:has(.main-nav__menu[open]) .main-nav__logo {
      top: auto;
      bottom: -27px;
    }
  }

  @media (width >= 768px) {
    .main-nav {
      max-width: var(--layout-width);
    }

    .main-nav__toggle {
      display: none;
    }

    .main-nav__menu::details-content {
      block-size: auto;
      content-visibility: visible;
    }
  }

  @media (width >= 1200px) {
    .main-nav__logo,
    .main-nav__logo-image {
      width: 187px;
      height: 96px;
    }

    .main-nav__logo {
      margin-left: -93px;
    }
  }

  .site-list__link {
    display: block;
    transition:
      color var(--duration-quick) var(--ease-out),
      background-color var(--duration-quick) var(--ease-out),
      border-top-color var(--duration-quick) var(--ease-out);
  }

  a.site-list__link:focus-visible {
    outline: 3px solid currentcolor;
    outline-offset: -4px;
  }

  @media (width < 768px) {
    .site-list__item:last-child .site-list__link {
      border-bottom: none;
      box-shadow: inset 0 -10px 10px -12px #000;
    }

    .site-list__link {
      padding: 7px 15px;
      font-weight: 700;
      font-size: 18px;
      line-height: 40px;
      color: var(--color-text-inverse);
      text-align: center;
      background-color: var(--color-brand);
      border-top: 1px solid var(--color-divider-nav-top);
      border-bottom: 1px solid var(--color-divider-nav-bottom);
    }

    a.site-list__link:hover,
    a.site-list__link:focus {
      background-color: var(--color-brand-hover);
      border-top-color: transparent;
    }

    a.site-list__link:active {
      color: var(--color-text-inverse-faded);
      background-color: var(--color-brand-active);
      border-top-color: transparent;
    }
  }

  @media (width >= 768px) {
    .site-list {
      display: flex;
      flex-wrap: wrap;
      width: 100%;
    }

    .site-list__item {
      width: 20%;
      min-height: 56px;
      padding: 15px;
      text-align: center;
    }

    .site-list__item:nth-child(2) {
      margin-right: 153px;
    }

    .site-list__item:nth-child(3) {
      margin-left: auto;
    }

    .site-list__link {
      font-weight: 700;
      font-size: 14px;
      line-height: 26px;
      color: var(--color-text-strong);
    }

    a.site-list__link:hover,
    a.site-list__link:focus {
      color: var(--color-brand);
    }

    a.site-list__link:active {
      color: var(--color-text-strong-faded);
    }
  }

  @media (width >= 1200px) {
    .site-list__item:nth-child(2) {
      margin-right: 240px;
    }
  }
</style>
