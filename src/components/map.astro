---
import ResponsiveImage from '@/components/responsive-image.astro'
import { localeOf, useTranslations } from '@/i18n'

const locale = localeOf(Astro.currentLocale)
const t = useTranslations(Astro.currentLocale)

const MAP_EMBED = `https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d996966.432186891!2d-112.25007717238842!3d34.8385587290032!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x872da132f942b00d%3A0x5548c523fa6c8efd!2z0KHQtdC00L7QvdCwLCDQkNGA0LjQt9C-0L3QsCA4NjMzNiwg0KHQqNCQ!5e0!3m2!1s${locale}!2skz!4v1568385633387!5m2!1s${locale}!2skz`
---

<section class="page-main__map map">
  <h2 class="visually-hidden">{t.map.heading}</h2>
  <div class="map__wrap">
    <iframe
      class="map__iframe"
      title={t.map.frameTitle}
      src={MAP_EMBED}
      width="320"
      height="350"
      loading="lazy"></iframe>
    <div class="map__box">
      <ResponsiveImage name="bg-map" alt={t.map.imageAlt} />
    </div>
  </div>
</section>

<style>
  .map__wrap {
    position: relative;
    min-height: 350px;
  }

  .map__iframe {
    position: relative;
    z-index: 10;
    width: 100%;
    border: none;
  }

  .map__box {
    position: absolute;
    top: 0;
    left: 50%;
    width: 320px;
    height: 350px;
    margin-left: -160px;
  }

  .map__box::before {
    content: '';
    position: absolute;
    top: 163px;
    left: 146px;
    z-index: 1;
    display: block;
    width: 27px;
    height: 27px;
    background-image: url('/img/icon-map-marker.svg');
    background-repeat: no-repeat;
    background-position: 0 0;
  }

  @media (width >= 768px) {
    .map {
      max-width: var(--layout-width);
      margin-inline: auto;
    }

    .map__box {
      width: 768px;
      margin-left: -384px;
    }

    .map__box::before {
      left: 370px;
    }
  }

  @media (width >= 1200px) {
    .map__box {
      left: 0;
      width: 100%;
      margin-left: 0;
    }

    .map__box::before {
      left: 585px;
    }
  }
</style>
