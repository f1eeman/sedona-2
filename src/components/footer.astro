---
const YEAR = new Date().getFullYear()

const SOCIAL = [
  {
    href: 'https://www.twitter.com/sedona',
    label: 'Мы в Твиттере',
    icon: 'icon-twitter',
    width: 18,
    height: 14,
  },
  {
    href: 'https://www.facebook.com/sedona',
    label: 'Мы в Фейсбуке',
    icon: 'icon-facebook',
    width: 9,
    height: 18,
  },
  {
    href: 'https://www.youtube.com/sedona',
    label: 'Мы в Ютьюбе',
    icon: 'icon-youtube',
    width: 20,
    height: 14,
  },
]
---

<footer class="page-footer">
  <div class="page-footer__container">
    <p class="page-footer__sedona-hashtag sedona-hashtag">
      <a class="sedona-hashtag__link" href="https://www.instagram.com/sedona"
        >#visitsedona</a
      >
    </p>

    <ul class="page-footer__social-list social-list">
      {
        SOCIAL.map((item) => (
          <li class="social-list__item">
            <a class="social-list__link" href={item.href}>
              <span class="visually-hidden">{item.label}</span>
              <svg
                class="social-list__icon"
                width={item.width}
                height={item.height}
                aria-hidden="true"
              >
                <use href={`#${item.icon}`} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="page-footer__copyright copyright">
      <span class="copyright__text">© {YEAR} Седона</span>
    </p>
  </div>
</footer>

<style>
  .page-footer {
    background-color: var(--color-surface-footer);
  }

  .page-footer__container {
    padding: 32px 20px 23px;
  }

  .page-footer__sedona-hashtag {
    margin-inline: auto;
    margin-bottom: 35px;
  }

  .page-footer__social-list {
    margin-inline: auto;
    margin-bottom: 27px;
  }

  .page-footer__copyright {
    margin-inline: auto;
  }

  .sedona-hashtag {
    width: 151px;
    text-align: center;
  }

  .sedona-hashtag__link {
    font-weight: 700;
    font-size: 21px;
    line-height: 26px;
    color: var(--color-text-strong);
    transition: color var(--duration-quick) var(--ease-out);
  }

  .sedona-hashtag__link:focus-visible {
    outline: 3px solid var(--color-text-strong);
    outline-offset: 3px;
  }

  .sedona-hashtag__link:hover,
  .sedona-hashtag__link:focus {
    color: var(--color-brand);
  }

  .sedona-hashtag__link:active {
    color: var(--color-text-strong-faded);
  }

  .social-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 151px;
  }

  .social-list__item {
    margin-bottom: 10px;
  }

  .social-list__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 48px;
    background-color: var(--color-brand);
    transition: background-color var(--duration-quick) var(--ease-out);
  }

  .social-list__link:focus-visible {
    outline: 3px solid var(--color-text-strong);
    outline-offset: 3px;
  }

  .social-list__link:hover,
  .social-list__link:focus {
    background-color: var(--color-brand-hover);
  }

  .social-list__link:active {
    background-color: var(--color-brand-active);
  }

  .social-list__icon {
    fill: var(--color-text-inverse);
    transition: fill var(--duration-quick) var(--ease-out);
  }

  .social-list__link:active .social-list__icon {
    fill: var(--color-text-inverse-faded);
  }

  .copyright {
    width: 140px;
    text-align: center;
  }

  .copyright__text {
    font-size: 14px;
    line-height: 26px;
    color: var(--color-text-strong);
  }

  @media (width >= 768px) {
    .page-footer__container {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-start;
      max-width: var(--layout-width);
      margin-inline: auto;
      padding: 32px 60px 35px;
    }

    .page-footer__sedona-hashtag,
    .page-footer__social-list,
    .page-footer__copyright {
      margin: 0;
    }

    .sedona-hashtag {
      width: 140px;
      padding-top: 10px;
      text-align: left;
    }

    .copyright {
      padding-top: 5px;
      text-align: right;
    }
  }

  @media (width >= 1200px) {
    .page-footer__container {
      padding-inline: 120px;
    }
  }
</style>
