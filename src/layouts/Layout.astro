---
import { Font } from 'astro:assets'
import Seo from '@/components/seo.astro'
import Sprite from '@/components/sprite.astro'
import Header from '@/components/header.astro'
import Banner from '@/components/banner.astro'
import Footer from '@/components/footer.astro'
import { localeOf, useTranslations } from '@/i18n'
import { NAV_HREF, type NavKey } from '@/data/nav'

import '@/styles/index.css'

interface Props {
  page: NavKey
  banner?: 'index' | 'inner'
}

const { page, banner = 'inner' } = Astro.props

const locale = localeOf(Astro.currentLocale)
const t = useTranslations(Astro.currentLocale)
const meta = t.pages[page]
const path = NAV_HREF[page]
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo title={meta.title} description={meta.description} {path} />
    <Font
      cssVariable="--font-pt-sans"
      preload={[{ weight: 400 }, { weight: 700 }]}
    />
  </head>
  <body>
    <Sprite />
    <Header {page} />
    <main class="page-main">
      <h1 class="visually-hidden">{meta.heading}</h1>
      <Banner variant={banner} />
      <slot />
    </main>
    <Footer {page} />
    <script>
      import { initReveal } from '@/scripts/reveal'

      initReveal()
    </script>
  </body>
</html>
