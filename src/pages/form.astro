---
import Layout from '@/layouts/Layout.astro'
import ReviewForm from '@/components/review-form.astro'
import Modal from '@/components/modal.astro'
---

<Layout
  title="Форма отзыва — Седона"
  description="Оставьте отзыв об отелях Седоны и посещённых достопримечательностях."
  heading="Форма отзыва"
  path="/form/"
>
  <ReviewForm />

  <Modal
    name="error"
    title="Что-то пошло не так!"
    text="Проверьте поля, выделенные красным, скорее всего вы забыли их заполнить"
    action="Ок"
  />
  <Modal
    name="success"
    title="Ваш отзыв отправлен!"
    text="Спасибо за ваше участие, ваш отзыв уже поступил к нам.<br /> В ближайшее время мы опубликуем его на сайте."
    action="Закрыть окно"
  />
</Layout>

<script>
  import { initReviewForm } from '@/scripts/review-form'

  initReviewForm()
</script>
