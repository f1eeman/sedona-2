---
import Layout from '@/layouts/Layout.astro'
import PhotoGallery from '@/components/photo-gallery.astro'
import VideoPlayer from '@/components/video-player.astro'
import { localePaths, useTranslations } from '@/i18n'

export const getStaticPaths = localePaths

const t = useTranslations(Astro.currentLocale)
---

<Layout page="photo">
  <section class="page-main__media media">
    <h2 class="media__title">{t.pages.photo.mediaTitle}</h2>
    <PhotoGallery />
    <VideoPlayer />
  </section>
</Layout>

<style>
  .media {
    padding-top: 38px;
    margin-bottom: 43px;
  }

  .media__title {
    width: 60%;
    max-width: 520px;
    margin-inline: auto;
    padding-inline: 20px;
    font-weight: 700;
    font-size: 18px;
    line-height: 26px;
    color: var(--color-text-strong);
    text-align: center;
  }

  @media (width >= 768px) {
    .media {
      max-width: var(--layout-width);
      margin-inline: auto;
      padding-top: 75px;
      padding-inline: 60px;
    }

    .media__title {
      margin-bottom: 19px;
      padding-inline: 60px;
      font-size: 30px;
    }
  }

  @media (width >= 1200px) {
    .media {
      margin-bottom: 87px;
      padding: 110px 0 0;
    }
  }
</style>
