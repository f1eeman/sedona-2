---
import Layout from '@/layouts/Layout.astro'
import ReviewForm from '@/components/review-form.astro'
import Modal from '@/components/modal.astro'
import { localePaths, useTranslations } from '@/i18n'

export const getStaticPaths = localePaths

const t = useTranslations(Astro.currentLocale)
---

<Layout page="form">
  <ReviewForm />

  <Modal
    name="error"
    title={t.modal.error.title}
    text={t.modal.error.text}
    action={t.modal.error.action}
  />
  <Modal
    name="success"
    title={t.modal.success.title}
    text={t.modal.success.text}
    action={t.modal.success.action}
  />
</Layout>

<script>
  import { initReviewForm } from '@/scripts/review-form'

  initReviewForm()
</script>
